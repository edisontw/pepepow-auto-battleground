{
  "name": "pepepow-auto-battleground",
  "version": "0.9.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run build:sites",
    "build:next": "next build",
    "start": "next start",
    "lint": "eslint app tests --ignore-pattern .next --ignore-pattern dist",
    "balance:matrix": "node --import tsx scripts/ai-matchup-matrix.ts",
    "dev:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build:sites": "bash scripts/build-verified.sh",
    "start:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "lint:sites": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "npm run build && node --test tests/rendered-html.test.mjs && node --import tsx --test tests/*.test.ts",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "PEPEPOW Auto Battleground"
}
